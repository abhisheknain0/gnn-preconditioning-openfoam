FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      iterReduceCouplingDict;
}
enabled                 true;
startInjectTime         0;
injectEveryTimeStep     false;
macroDt                 0.01;
modelPath               "constant/iterreduce/model_inference.ts";
contextDir              "constant/iterreduce/context";
applyVelocityGuess      true;
applyPressureGuess      true;
correctBoundariesAfterInjection true;
refreshPhiAfterInjection false;
refreshUfAfterInjection false;
skipSmallUpdates        true;
minRelativeVelocityUpdate 1e-7;
minRelativePressureUpdate 1e-7;
preserveUz              true;
guessBlendAlpha         1.0;
pressureGaugeMode       mean;
abortOnError            true;
logGuessDiagnostics     true;
dumpGuessFields         false;
dumpGuessFieldLimit     0;
device                  "cuda:0";
predictorMode           model;
blendMode               manual;      // manual | dtScaled
gnnTrainingDt           0.01;        // used when blendMode=dtScaled
dtScaledAlphaMax        1.0;         // upper clamp on dt_OF/dt_GNN
